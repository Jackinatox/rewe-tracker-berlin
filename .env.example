# Local: docker compose (bun run db:up). Production: set by Vercel's Neon integration (pooled URL).
DATABASE_URL=postgresql://rewe:rewe@localhost:5434/rewe
# Direct (non-pooled) connection for prisma migrate. Neon sets this as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://rewe.example.com
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob read/write token (Vercel → Storage → Blob). Photos are disabled without it.
BLOB_READ_WRITE_TOKEN=

# Only needed to regenerate data/stores.json (bun run stores:fetch).
GOOGLE_MAPS_API_KEY=
